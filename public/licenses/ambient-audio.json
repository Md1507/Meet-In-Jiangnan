                      "path":  "public/audio/ambient/resident-b-neighborhood-like-reply.wav",
                      "sha256":  "0ac6bae8d72c33e2c46836a1272f5a0cbdccc18cccc1b9bf34de21baffc42cfe"
                  },
                  {
                      "id":  "resident-b-neighborhood-adjusting-sample",
                      "text":  "我还不太习惯。",
                      "pinyin":  "Wǒ hái bú tài xíguàn.",
                      "meaningVi":  "Cháu vẫn chưa quen lắm.",
                      "path":  "public/audio/ambient/resident-b-neighborhood-adjusting-sample.wav",
                      "sha256":  "ab58f566274cbc0ea41eef5dd537e79da8c2ce7e9e1084e43e17a8ee2637baed"
                  },
                  {
                      "id":  "resident-b-neighborhood-adjusting-reply",
                      "text":  "慢慢来，适应新地方需要时间。",
                      "pinyin":  "Mànmàn lái, shìyìng xīn dìfang xūyào shíjiān.",
                      "meaningVi":  "Cứ từ từ, làm quen với nơi mới cần thời gian mà.",
                      "path":  "public/audio/ambient/resident-b-neighborhood-adjusting-reply.wav",
                      "sha256":  "7d25f8545ed490a1b0a529478cc82817b2d48f66aa2d2718d682dd471cd1d96d"
                  },
                  {
