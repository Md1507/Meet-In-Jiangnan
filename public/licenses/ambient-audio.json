    "lines":  [
                  {
                      "id":  "student-a-newcomer-prompt",
                      "text":  "你是新来的学生吗？",
                      "pinyin":  "Nǐ shì xīn lái de xuésheng ma?",
                      "meaningVi":  "Bạn là sinh viên mới đến à?",
                      "path":  "public/audio/ambient/student-a-newcomer-prompt.wav",
                      "sha256":  "dd318c7952ad3c5fded0799fcc3d584ce202d8a62334e7a373021cd1a4134f93"
                  },
                  {
                      "id":  "student-a-newcomer-student-sample",
                      "text":  "对，我是新生。",
                      "pinyin":  "Duì, wǒ shì xīnshēng.",
                      "meaningVi":  "Đúng, mình là sinh viên mới.",
                      "path":  "public/audio/ambient/student-a-newcomer-student-sample.wav",
                      "sha256":  "78cd0b11c7b71dcfe696da8a3e76d3dffb5dc481eae9c784d06b2501c9c87c0a"
                  },
                  {
                      "id":  "student-a-newcomer-student-reply",
                      "text":  "欢迎你！慢慢熟悉这里吧。",
                      "pinyin":  "Huānyíng nǐ! Mànmàn shúxī zhèlǐ ba.",
                      "meaningVi":  "Chào mừng bạn! Cứ từ từ làm quen với nơi này nhé.",
                      "path":  "public/audio/ambient/student-a-newcomer-student-reply.wav",
                      "sha256":  "26796d18f5ac69f26df2210df414f78845212e49258c1a2d08ee35ab55bdec4c"
                  },
                  {
                      "id":  "student-a-newcomer-visitor-sample",
                      "text":  "不是，我来找朋友。",
                      "pinyin":  "Bú shì, wǒ lái zhǎo péngyou.",
                      "meaningVi":  "Không, mình đến tìm bạn.",
                      "path":  "public/audio/ambient/student-a-newcomer-visitor-sample.wav",
                      "sha256":  "4c5e2e89cfcf48bc3494f36ef36ad4c4d6e1cfbbb09709a74142bc5ac06d9e96"
                  },
                  {
                      "id":  "student-a-newcomer-visitor-reply",
                      "text":  "原来是这样，希望你玩得开心。",
                      "pinyin":  "Yuánlái shì zhèyàng, xīwàng nǐ wán de kāixīn.",
                      "meaningVi":  "Ra là vậy, chúc bạn có thời gian vui vẻ.",
                      "path":  "public/audio/ambient/student-a-newcomer-visitor-reply.wav",
                      "sha256":  "8310476d718b467e87beaf595bdb5633056c66792ba0639b0a83c254188522cc"
                  },
                  {
                      "id":  "student-a-destination-prompt",
                      "text":  "你想去哪里？",
                      "pinyin":  "Nǐ xiǎng qù nǎlǐ?",
                      "meaningVi":  "Bạn muốn đi đâu?",
                      "path":  "public/audio/ambient/student-a-destination-prompt.wav",
                      "sha256":  "37b9942be8f8258cbdeaa7c5ee1d25d9bd284cafbe2173a4b2ef32bb0099fac7"
                  },
                  {
                      "id":  "student-a-destination-place-sample",
                      "text":  "我想去食堂。",
                      "pinyin":  "Wǒ xiǎng qù shítáng.",
                      "meaningVi":  "Mình muốn đến nhà ăn.",
                      "path":  "public/audio/ambient/student-a-destination-place-sample.wav",
                      "sha256":  "3ada511b352ae94112d78c931c29e34c6c9e593f297fbefe5d9f001666641809"
                  },
                  {
                      "id":  "student-a-destination-place-reply",
                      "text":  "好的，校园里的路牌可以帮你。",
                      "pinyin":  "Hǎo de, xiàoyuán lǐ de lùpái kěyǐ bāng nǐ.",
                      "meaningVi":  "Được, các biển chỉ dẫn trong trường sẽ giúp bạn.",
                      "path":  "public/audio/ambient/student-a-destination-place-reply.wav",
                      "sha256":  "610580be5012e5e123822c79e85bee38d4357e86bc8653b76f611908680bd0b9"
                  },
                  {
                      "id":  "student-a-destination-unsure-sample",
                      "text":  "我还没想好。",
                      "pinyin":  "Wǒ hái méi xiǎng hǎo.",
                      "meaningVi":  "Mình vẫn chưa nghĩ ra.",
                      "path":  "public/audio/ambient/student-a-destination-unsure-sample.wav",
                      "sha256":  "6a11c549df8d8c384405789347a782673130cafc100047ff69261797b688a89c"
                  },
                  {
                      "id":  "student-a-destination-unsure-reply",
                      "text":  "没关系，随便走走也不错。",
                      "pinyin":  "Méi guānxi, suíbiàn zǒuzou yě bú cuò.",
                      "meaningVi":  "Không sao, đi dạo một chút cũng hay mà.",
                      "path":  "public/audio/ambient/student-a-destination-unsure-reply.wav",
                      "sha256":  "893f7a96184ad5f9973981035026210d260477a8e9aec6b753e4bbe52c4bb798"
                  },
                  {
                      "id":  "resident-b-neighborhood-prompt",
                      "text":  "你喜欢这里的生活吗？",
                      "pinyin":  "Nǐ xǐhuan zhèlǐ de shēnghuó ma?",
                      "meaningVi":  "Cháu thích cuộc sống ở đây không?",
