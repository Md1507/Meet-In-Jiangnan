                      "meaningVi":  "Không sao, cháu cứ từ từ tìm nhé.",
                      "path":  "public/audio/ambient/resident-b-hobby-none-reply.wav",
                      "sha256":  "916627b4b6b0d363970fd652414afeac11fd4bf7d337f9f6a83689cc27610ab3"
                  },
                  {
