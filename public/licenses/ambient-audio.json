                      "sha256":  "35f899a685d01b8f54bc1ba1c2db5a4f140a7034a272cacf32a8575bdfcda439"
                  },
                  {
                      "id":  "elder-c-sit-no-reply",
                      "text":  "好的，路上小心。",
                      "pinyin":  "Hǎo de, lùshang xiǎoxīn.",
                      "meaningVi":  "Được, cháu đi đường cẩn thận nhé.",
