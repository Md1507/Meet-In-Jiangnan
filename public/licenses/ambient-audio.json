                      "sha256":  "29e98c975f7447b1a21f0095569cc911c374ab8278e7a96b6222f64eb5bf7023"
                  },
                  {
                      "id":  "resident-b-neighborhood-like-sample",
                      "text":  "我很喜欢这里。",
                      "pinyin":  "Wǒ hěn xǐhuan zhèlǐ.",
                      "meaningVi":  "Cháu rất thích nơi này.",
                      "path":  "public/audio/ambient/resident-b-neighborhood-like-sample.wav",
                      "sha256":  "9160c59726cc4e1f540b3eec14bc82f937abe17fe40c922e010cee58398ebf11"
                  },
                  {
                      "id":  "resident-b-neighborhood-like-reply",
                      "text":  "那就好，欢迎常来逛逛。",
                      "pinyin":  "Nà jiù hǎo, huānyíng cháng lái guàngguang.",
